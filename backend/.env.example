# Copy this file to .env and fill in your Salesforce credentials
# Do NOT commit your real .env to version control

SF_CLIENT_ID=your_client_id_here
SF_CLIENT_SECRET=your_client_secret_here
SF_USERNAME=your_salesforce_username
SF_PASSWORD=your_password_here
SF_SECURITY_TOKEN=your_security_token_here
# Use https://test.salesforce.com for sandbox or https://login.salesforce.com for production
SF_INSTANCE_URL=https://login.salesforce.com
SF_ACCESS_TOKEN=your_saved_access_token_here
